{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "XiaoJin"
  ],
  "contributors": [
    "XiaoJin"
  ],
  "license": "${mod_license}",
  "icon": "META-INF/pack.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "xiaojin.gachaaddiction.GachaAddiction"
    ],
    "client": [
      "xiaojin.gachaaddiction.GachaAddictionClient"
    ]
  },
  "accessWidener": "gachaaddiction.accesswidener",
  "mixins": [
    "gachaaddiction.mixins.json",
    {
      "config": "gachaaddiction.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "forgeconfigapiport": "*"
  },
  "suggests": {
    "lootr": "*",
    "ftbquests": "*",
    "modmenu": "*"
  }
}
